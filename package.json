{
  "name": "pixoji",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('package.json','utf8')).requiredFiles.filter(f=>!fs.existsSync(f));if(m.length){console.error('These project files are missing - copy them from the zip (keep your own levels/ and shared/presets.json):\\n  '+m.join('\\n  '));process.exit(1)}\"",
    "predev": "npm run check && node tools/build-levels.js",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run check && node tools/build-levels.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate": "node tools/generate-level.js",
    "solve": "node tools/solver.js",
    "show": "node tools/show-level.js",
    "levels": "node tools/build-levels.js",
    "levels:check": "node tools/build-levels.js --verify --dry-run",
    "levels:complexity": "node tools/level-complexity.js",
    "presets:check": "node tools/presets-file.js"
  },
  "dependencies": {
    "pixi.js": "^8.8.1"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  },
  "requiredFiles": [
    "index.html",
    "package.json",
    "public/icons/apple-touch-icon.png",
    "public/icons/icon-192.png",
    "public/icons/icon-512.png",
    "public/icons/icon-maskable-512.png",
    "public/manifest.webmanifest",
    "pwa/sw.template.js",
    "shared/clue-types.js",
    "shared/fulfilled.js",
    "shared/generator.js",
    "shared/json-check.js",
    "shared/level-index.js",
    "shared/logic-core.js",
    "shared/options.js",
    "shared/presets.js",
    "shared/presets.json",
    "shared/solver-core.js",
    "shared/tutorial.js",
    "src/app-flow.js",
    "src/config.js",
    "src/game/catalog.js",
    "src/game/cell.js",
    "src/game/clue-icons.js",
    "src/game/grid.js",
    "src/game/history.js",
    "src/game/level-source.js",
    "src/game/next-level.js",
    "src/game/presets.js",
    "src/game/saved-game.js",
    "src/game/tutorial-highlights.js",
    "src/game/tutorial.js",
    "src/main.js",
    "src/progress.js",
    "src/pwa/register.js",
    "src/scenes/game-scene.js",
    "src/scenes/menu-scene.js",
    "src/styles.css",
    "src/ui/clue-icon.js",
    "src/ui/tutorial-panel.js",
    "src/ui/widgets.js",
    "src/version.js",
    "src/workers/generator.worker.js",
    "tools/build-levels.js",
    "tools/cli-utils.js",
    "tools/generate-level.js",
    "tools/level-complexity.js",
    "tools/level-order.js",
    "tools/level-tools.js",
    "tools/presets-file.js",
    "tools/presets-plugin.js",
    "tools/pwa-plugin.js",
    "tools/show-level.js",
    "tools/solver.js",
    "vite.config.js"
  ]
}
